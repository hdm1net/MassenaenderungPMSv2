<Window x:Class="MassenaenderungPMSv2Gui.Splash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MassenaenderungPMSv2Gui"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="White"
        WindowStartupLocation="CenterScreen"
        Width="800" Height="500"
        Topmost="True"
        Title="Splash">
    <Border CornerRadius="10" BorderBrush="DarkGray" BorderThickness="2" Padding="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Height="400" Width="500" Source="pack://application:,,,/Content/splash.png"/>
            <TextBlock x:Name="VersionLabel" Text="Version:" HorizontalAlignment="Center" FontSize="16"/>
            <TextBlock Text="Lizenz: MIT" FontSize="16" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>


